# Copy to .env and fill in. .env is gitignored and dockerignored — never commit.

# ── Access control ───────────────────────────────────────────────────────────
# password  = one shared gate password (simplest; no registration, no email)
# accounts  = per-person self-service login with verified email (needs email, see below)
AOS8_AUTH_MODE=password
# Required for password mode — the single password everyone uses to get in.
# The app REFUSES to serve if this is left at the placeholder below or is
# shorter than 16 characters.
AOS8_APP_PASSWORD=change-me-to-a-strong-shared-password

# ── App credential persistence (optional) ────────────────────────────────────
# Fernet key enabling the encrypted "Remember". In password mode this is a
# single SHARED store (everyone with the password sees saved creds); leave blank
# to keep creds session-only. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AOS8_CREDSTORE_KEY=

# ── (proxy mode only) Trusted identity header ────────────────────────────────
# The ONE header the app treats as the verified identity. The reverse proxy
# must SET it and inbound-STRIP it (see deploy/Caddyfile) — anything reaching
# :8501 directly can otherwise claim any identity.
AOS8_IDENTITY_HEADER=X-Forwarded-Email

# ── (local mode only) Principal used to scope the credential store ───────────
AOS8_LOCAL_USER=local@localhost

# ── Controller TLS verification (optional) ───────────────────────────────────
# AOS 8 controllers ship self-signed certs, so verification is ON by default
# and a stock cert blocks out-of-box discovery until the controller's CA is
# imported here (or AOS8_DEV_MODE is set for a local lab). Set AOS8_CA_BUNDLE
# to protect the controller admin credentials from MITM on the management
# network.
AOS8_CA_BUNDLE=

# ── (accounts mode only) Account-verification email ──────────────────────────
# Only needed if AOS8_AUTH_MODE=accounts. Registration emails a 6-digit code.
# The From can be any sender (Gmail, throwaway, etc.). Pick one:
#
# (A) Gmail — easiest + reliable.
#     Enable 2FA, then create an App Password
#     (Google Account → Security → App passwords). From must equal the account.
# AOS8_SMTP_MODE=relay
# AOS8_SMTP_HOST=smtp.gmail.com
# AOS8_SMTP_PORT=587
# AOS8_SMTP_USER=youraccount@gmail.com
# AOS8_SMTP_PASS=your-16-char-app-password
# AOS8_SMTP_FROM=youraccount@gmail.com
#
# (B) Transactional provider (SendGrid/Resend/Brevo free tier) — same shape:
#     host smtp.sendgrid.net, user "apikey", pass <API key>, From your verified sender.
#
# (C) direct — no account at all; the app does the MX lookup and delivers itself.
#     May be spam-filtered from an unauthenticated IP. Set From to a domain you control:
# AOS8_SMTP_MODE=direct
# AOS8_SMTP_FROM=no-reply@some-domain-you-own
#
# With nothing set, codes are written to the container log (DEV ONLY).
AOS8_SMTP_MODE=
AOS8_SMTP_HOST=
AOS8_SMTP_PORT=587
AOS8_SMTP_USER=
AOS8_SMTP_PASS=
AOS8_SMTP_FROM=

# Relay-mode TLS: STARTTLS on port 587 (the default), or implicit TLS on 465
# with _SSL=true. Leave as-is unless your provider says otherwise.
AOS8_SMTP_SSL=false
AOS8_SMTP_STARTTLS=true

# ── (accounts mode only) Registration policy ─────────────────────────────────
# Restrict self-service registration to ONE email domain (e.g. example.com).
# ⚠ EMPTY (the shipped value) means ANY email address on the internet can
# register itself an account in a tool that writes to live customer tenants —
# set a domain for any deployment reachable beyond your own machine.
AOS8_ALLOWED_EMAIL_DOMAIN=
# true = with no SMTP configured, print verification codes to the server
# console. LOCAL DEVELOPMENT ONLY — anyone with log access can take over a
# registration. Empty (the default) keeps it off.
AOS8_ALLOW_CONSOLE_CODES=
# Path to the user registry. Empty = the default
# ~/.aos8-migration/users.json, which lives on the persistent volume.
AOS8_USERS_FILE=
